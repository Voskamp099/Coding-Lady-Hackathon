# ===== TimeMirror 后端环境变量 =====
# 复制本文件为 .env 并填入真实值

# LLM API（默认用阶跃星辰 StepFun）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.stepfun.com/v1
MODEL_NAME=step-3.7-flash

# 调试模式（本地开发 true，生产 false）
DEBUG=true

# 数据集配置（可选，有默认值）
# DATASET_CSV_PATH=data/growth-records.csv
# DATASET_LABEL=child_0_7
